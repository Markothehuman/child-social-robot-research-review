@article{jin_effect_2027,
	title = {The effect of social robot authority on epistemic vigilance in early childhood},
	volume = {275},
	issn = {0022-0965},
	url = {https://www.sciencedirect.com/science/article/pii/S0022096526002407},
	doi = {10.1016/j.jecp.2026.106688},
	abstract = {Social robots are increasingly deployed as tutors and learning partners, yet their authority cues may discourage children from questioning or verifying information. We investigated whether robot authority influences Chinese children’s epistemic vigilance and which source of authority drives this effect. In Study 1 (N = 128, ages 4 and 6, Mage = 5.39 years, {SD} = 0.92, 66 girls and 62 boys), robots with high and low overall authority asserted that all aliens in a task had three eyes. Children’s verification behaviors were assessed in terms of the number of times they checked the information, the length of time they spent checking, and how much time passed between checks. Results showed that children engaged in significantly less verification in the high-authority condition, and 6-year-olds checked more often than 4-year-olds. Study 2 (N = 200, ages 4 and 6, Mage = 5.19 years, {SD} = 0.92, 97 girls and 103 boys) built on Study 1 by manipulating two sources of authority: role authority (teacher-like vs. peer-like) and cognitive authority (knowledgeable vs. unknowledgeable). The same task and outcome measures were used as in Study 1. The results showed that cognitive authority significantly decreased children’s verification behavior, but there was no significant effect of role authority or child age. Together, these findings suggest that authority cues can shape how much evidence children seek before accepting robot testimony, particularly when the robot is presented as knowledgeable.},
	pages = {106688},
	journaltitle = {Journal of Experimental Child Psychology},
	shortjournal = {Journal of Experimental Child Psychology},
	author = {Jin, Xudong and Cao, Xinyun and Li, Hui},
	urldate = {2026-10-16},
	date = {2027-03-01},
	keywords = {Authority, Epistemic vigilance, Social robots, Young children},
	file = {ScienceDirect Snapshot:files/447/S0022096526002407.html:text/html},
}

@article{indurkhya_lessons_2024,
	title = {Lessons in Developing a Behavioral Coding Protocol to Analyze In-the-Wild Child–Robot Interaction Events and Experiments},
	volume = {13},
	rights = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2079-9292},
	url = {https://www.mdpi.com/2079-9292/13/7/1175},
	doi = {10.3390/electronics13071175},
	abstract = {Behavioral analyses of in-the-wild {HRI} studies generally rely on interviews or visual information from videos. This can be very limiting in settings where video recordings are not allowed or limited. We designed and tested a vocalization-based protocol to analyze in-the-wild child–robot interactions based upon a behavioral coding scheme utilized in wildlife biology, specifically in studies of wild dolphin populations. The audio of a video or audio recording is converted into a transcript, which is then analyzed using a behavioral coding protocol consisting of 5–6 categories (one indicating non-robot-related behavior, and 4–5 categories of robot-related behavior). Refining the code categories and training coders resulted in increased agreement between coders, but only to a level of moderate reliability, leading to our recommendation that it be used with three coders to assess where there is majority consensus, and thereby correct for subjectivity. We discuss lessons learned in the design and implementation of this protocol and the potential for future child–robot experiments analyzed through vocalization behavior. We also perform a few observational behavior analyses from vocalizations alone to demonstrate the potential of this field.},
	pages = {1175},
	number = {7},
	journaltitle = {Electronics},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Indurkhya, Xela and Venture, Gentiane},
	urldate = {2026-10-16},
	date = {2024-01},
	langid = {english},
	keywords = {behavioral coding, child–robot interaction, in-the-wild {HRI}, vocalization-based analysis},
	file = {Full Text PDF:files/451/Indurkhya and Venture - 2024 - Lessons in Developing a Behavioral Coding Protocol to Analyze In-the-Wild Child–Robot Interaction Ev.pdf:application/pdf},
}

@inproceedings{rixen_long-term_2026,
	title = {Long-Term Integration of a Robot in an Inclusive Daycare: An Ethnographic Study Focused on Children and Caregivers},
	isbn = {979-8-4007-2128-1},
	url = {https://publikationen.bibliothek.kit.edu/1000192776},
	doi = {10.1145/3757279.3785578},
	shorttitle = {Long-Term Integration of a Robot in an Inclusive Daycare},
	abstract = {Embedding social robots in educational and/or childcare settings has potential to engage children while supporting caregivers. However, little is known about the practical, long-term integration of robots in such settings. Our work addresses this gap through an ethnographic study that adopts a year-long perspective toward a socially assistive robot in an inclusive daycare with a four-month robot deployment phase. Through Thematic Analysis, we highlight children's ability to develop a variety of self-determined interactions with the robot, while unveiling caregivers' need for its integration into structured routines such as meal times, as well as challenges for robustness of the robot in our research setting. On this basis, we make recommendations for the design of social robots for daycare environments.},
	eventtitle = {21st {ACM}/{IEEE} International Conference on Human-Robot Interaction ({HRI} 2026), Edinburgh, Vereinigtes Königreich, 16.03.2026 – 19.03.2026},
