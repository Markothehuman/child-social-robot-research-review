
@article{magnini_social_2027,
	title = {Social priming enhances young children’s trust in robots},
	volume = {273},
	issn = {0022-0965},
	url = {https://www.sciencedirect.com/science/article/pii/S0022096526001700},
	doi = {10.1016/j.jecp.2026.106618},
	abstract = {This study examined preschoolers’ selective trust in a robot versus a human informant, and whether social priming may increase trust by making the robot’s social characteristics more salient, using the word-learning paradigm. Children also completed the Theory of Mind ({ToM}) scale, along with an adapted naïve biology task and an Attribution of Mental States questionnaire assessing their beliefs about robots. In Experiment 1, eighty-six Italian children (aged 3 and 5) observed a competent robot ({NAO}) correctly labeling familiar objects and an incompetent human mislabeling them. The two informants then provided novel labels for unfamiliar objects. Three-year-olds endorsed labels from both informants equally, while five-year-olds preferentially endorsed the labels provided by the robot. {ToM} related to trust only for judgment scores (which informant was correct), an association largely explained by age. Experiment 2 investigated whether exposure to social priming would increase children’s trust. Eighty-five Canadian children (aged 3 and 5) completed the same selective trust procedure, except that they first viewed a social priming video designed to increase the robot’s perceived social agency. Both age groups preferred learning new labels from the robot, suggesting that social characteristics support children’s trust in robot informants, particularly among younger preschoolers. {ToM} predicted children’s endorsement of the robot’s labels, although this effect was largely explained by age. Together, the findings suggest that, by age 5, preschoolers exhibit robust sensitivity to the epistemic characteristics of informants, regardless of their agency. Younger children, in contrast, appear more likely to trust a robot displaying salient social characteristics.},
	pages = {106618},
	journaltitle = {Journal of Experimental Child Psychology},
	shortjournal = {Journal of Experimental Child Psychology},
	author = {Magnini, Margherita and Poulin-Dubois, Diane and Goldman, Elizabeth J. and Tacci, Andrea Luna and Aquilino, Letizia and Manzi, Federico and Baumann, Anna E. and Massaro, Davide and Marchetti, Antonella},
	urldate = {2026-10-07},
	date = {2027-01-01},
	keywords = {Epistemic trust, Priming, Selective social learning, Social robotics, Theory of mind},
	file = {ScienceDirect Full Text PDF:files/241/Magnini et al. - 2027 - Social priming enhances young children’s trust in robots.pdf:application/pdf;ScienceDirect Snapshot:files/242/S0022096526001700.html:text/html},
}

