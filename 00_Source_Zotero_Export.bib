@article{neumann_social_2020,
	title = {Social Robots and Young Children’s Early Language and Literacy Learning},
	volume = {48},
	issn = {1573-1707},
	url = {https://doi.org/10.1007/s10643-019-00997-7},
	doi = {10.1007/s10643-019-00997-7},
	abstract = {Due to recent advances in technology, social robots are emerging as educational tools with the potential to enhance early language and literacy skills in young children. Social robots are defined as machines that can socially interact and communicate intelligently with humans. A review of the literature was conducted to explore current knowledge on social robots and early language and literacy learning in typically developing children (0 to 8 years old). The database search terms were “social robots” {AND} (literacy {OR} language) {AND} “education”. Twelve databases were searched and 13 studies met the search criteria. Five key themes were identified: A theoretical framework for learning with social robots; Child engagement with social robots; Social robots and language and literacy activities; Social robots and language and literacy learning; and Characteristics of social robots for education. Few studies were found that specifically addressed social robots and early literacy learning. Although social robots were found to support early language learning, further research is needed to investigate social robots and early literacy learning in young children.},
	pages = {157--170},
	number = {2},
	journaltitle = {Early Childhood Education Journal},
	shortjournal = {Early Childhood Educ J},
	author = {Neumann, Michelle M.},
	urldate = {2026-10-12},
	date = {2020-03-01},
	langid = {english},
	keywords = {Social robots, Education, Language, Literacy, Young children},
}

@misc{urooj_advances_2026,
	location = {Rochester, {NY}},
	title = {Advances and Challenges in Emotion Recognition for Emotion-Aware Child–Robot Interaction: A Systematic Review},
	url = {https://papers.ssrn.com/abstract=6615886},
	doi = {10.2139/ssrn.6615886},
	shorttitle = {Advances and Challenges in Emotion Recognition for Emotion-Aware Child–Robot Interaction},
	abstract = {Socially assistive robots designed for interaction with children must be able to perceive and respond to emotional cues in a socially appropriate and ethically responsible manner. Emotion recognition therefore plays a critical role in effective child–robot interaction ({CRI}), particularly in educational, healthcare, and therapeutic contexts. However, recognizing children’s emotions remains challenging due to developmental variability, spontaneous expression, limited child-specific datasets, and constraints on data collection and annotation. This paper presents a systematic review of emotion recognition methods and their application in socially assistive child robotics. The review follows {PRISMA} guidelines and analyzes 63 peer-reviewed studies published between 2016 and 2025. The surveyed literature is organized into interactionfocused {CRI} systems and dataset-oriented studies involving children aged 3–15 years. Emotion recognition approaches are categorized into vision-based, speech-based, and multimodal methods. Vision-based techniques primarily rely on convolutional neural networks and transfer learning from adult datasets. Speech-based approaches exploit prosodic and spectral features using deep neural architectures. Multimodal frameworks integrate facial, vocal, and bodily cues to improve robustness under real-world interaction conditions. The review examines commonly used datasets, deep learning architectures, loss functions, and evaluation metrics for child emotion recognition.},
	number = {6615886},
	publisher = {Social Science Research Network},
	author = {Urooj, Ahtisham and Yusuf, Muhammad Adel and Nasir, Ali and El Ferik, Sami},
	urldate = {2026-10-12},
	date = {2026-04-20},
	langid = {english},
	keywords = {Affective Computing, Child-Robot Interaction, Deep Learning, Multimodal Emotion Recognition, Social Robotics},
	file = {Full Text PDF:files/442/Urooj et al. - 2026 - Advances and Challenges in Emotion Recognition for Emotion-Aware Child–Robot Interaction A Systemat.pdf:application/pdf},
}

