@incollection{hutchison_child-robot_2013,
	location = {Cham},
	title = {Child-Robot Interaction: Perspectives and Challenges},
	volume = {8239},
	isbn = {978-3-319-02674-9 978-3-319-02675-6},
	url = {http://link.springer.com/10.1007/978-3-319-02675-6_45},
	doi = {10.1007/978-3-319-02675-6_45},
	shorttitle = {Child-Robot Interaction},
	abstract = {Child-Robot Interaction ({cHRI}) is a promising point of entry into the rich challenge that social {HRI} is. Starting from three years of experiences gained in a {cHRI} research project, this paper oﬀers a view on the opportunities oﬀered by letting robots interact with children rather than with adults and having the interaction in real-world circumstances rather than lab settings. It identiﬁes the main challenges which face the ﬁeld of {cHRI}: the technical challenges, while tremendous, might be overcome by moving away from the classical perspective of seeing social cognition as residing inside an agent, to seeing social cognition as a continuous and self-correcting interaction between two agents.},
