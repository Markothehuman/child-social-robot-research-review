	date = {2020},
	langid = {english},
	keywords = {Child-robot interaction, Social robots, Education, Engagement levels},
}

@article{jong_childrens_2019,
	title = {Children’s acceptance of social robots: A narrative review of the research 2000–2017},
	volume = {20},
	issn = {1572-0373, 1572-0381},
	url = {https://www.jbe-platform.com/content/journals/10.1075/is.18071.jon},
	doi = {10.1075/is.18071.jon},
	shorttitle = {Children’s acceptance of social robots},
	abstract = {Abstract Social robots progressively enter children’s lives, but little is known about children’s acceptance of social robots and its antecedents. To fill this research gap, this narrative review surveyed 34 articles on child-robot interaction published between 2000 and 2017. We focused on robot, user, and interaction characteristics as potential antecedents of children’s intentional and behavioral social robot acceptance. In general, children readily accept robots. However, we found that social, adaptive robot behavior, children’s sex and age, as well as frequency of the interaction seem to affect acceptance. Additionally, we found various theoretical and methodological shortcomings in the field. The review concludes with recommendations and directions for future research on children’s acceptance of social robots.},
	pages = {393--425},
	number = {3},
	journaltitle = {Interaction Studies},
	publisher = {John Benjamins},
	author = {Jong, Chiara de and Peter, Jochen and Kühne, Rinaldo and Barco, Alex},
	urldate = {2026-10-12},
	date = {2019-11-18},
	langid = {english},
	file = {Full Text PDF:files/438/Jong et al. - 2019 - Children’s acceptance of social robots A narrative review of the research 2000–2017.pdf:application/pdf},
}

